{
    "scripts": {
        "dev": "concurrently -n css,js,serve -c \"#38BDF8,#F7DF1E,#A78BFA\" \"npm:dev:css\" \"npm:dev:js\" \"npm:dev:serve\"",
        "dev:css": "tailwindcss -i assets/css/theme/tailwind.css -o assets/css/bundles/styles.css --postcss --watch --poll --minify",
        "dev:js": "node build/compile-scripts.js --watch",
        "dev:serve": "serve . -l 3000",
        "build": "npm run build:css && npm run build:js",
        "build:css": "tailwindcss -i assets/css/theme/tailwind.css -o assets/css/bundles/styles.css --postcss --minify",
        "build:js": "node build/compile-scripts.js"
    },
    "dependencies": {
        "gsap": "^3.12.5",
        "lenis": "^1.3.23"
    },
    "devDependencies": {
        "autoprefixer": "latest",
        "chokidar": "^3.6.0",
        "concurrently": "^10.0.3",
        "esbuild": "^0.25.4",
        "fluid-tailwind": "latest",
        "postcss": "latest",
        "postcss-import": "latest",
        "postcss-import-ext-glob": "latest",
        "postcss-nested": "latest",
        "serve": "^14.2.4",
        "tailwindcss": "^3.4.17"
    }
}
